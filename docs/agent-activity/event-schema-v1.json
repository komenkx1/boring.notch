{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/komenkx1/boring.notch/blob/main/docs/agent-activity/event-schema-v1.json",
  "title": "Agent activity event version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventIdentifier",
    "agentRunIdentifier",
    "providerName",
    "eventKind",
    "occurredAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventIdentifier": {
      "type": "string",
      "format": "uuid"
    },
    "agentRunIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "providerName": {
      "type": "string",
      "enum": ["codex", "claude"]
    },
    "eventKind": {
      "type": "string",
      "enum": [
        "runStarted",
        "activityChanged",
        "attentionRequested",
        "attentionResolved",
        "assistantMessageCompleted",
        "usageUpdated",
        "runCompleted",
        "runFailed",
        "runInterrupted"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "modelLabel": {
      "type": "string",
      "maxLength": 120
    },
    "workingDirectory": {
      "type": "string",
      "maxLength": 4096
    },
    "repositoryLabel": {
      "type": "string",
      "maxLength": 200
    },
    "summaryText": {
      "type": "string",
      "maxLength": 2000
    },
    "attentionRequest": {
      "$ref": "#/$defs/attentionRequest"
    },
    "usageWindows": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/usageWindow"
      }
    },
    "providerEventName": {
      "type": "string",
      "maxLength": 200
    },
    "providerEventIdentifier": {
      "type": "string",
      "maxLength": 200
    }
  },
  "$defs": {
    "attentionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestIdentifier", "requestKind", "promptText", "canRespond"],
      "properties": {
        "requestIdentifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requestKind": {
          "type": "string",
          "enum": ["approval", "question", "notification"]
        },
        "promptText": {
          "type": "string",
          "maxLength": 4000
        },
        "canRespond": {
          "type": "boolean"
        }
      }
    },
    "usageWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowLabel", "usedPercentage"],
      "properties": {
        "windowLabel": {
          "type": "string",
          "maxLength": 120
        },
        "usedPercentage": {
          "type": "number",
          "minimum": 0
        },
        "windowDurationMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "resetsAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
